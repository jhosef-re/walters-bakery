# --- Aplicación ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Base de datos ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/walters_bakery?schema=public"

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=replace-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-refresh
JWT_REFRESH_TTL=7d

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- SMTP (notificaciones por correo) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Walters Bakery <no-reply@walters.local>"

# --- Job de vencimiento (CU-16) ---
# Offset en minutos después del fin del último turno configurado por sucursal.
# El job NO se ejecuta a hora fija global; se programa dinámicamente por sucursal.
JOB_VENCIMIENTO_OFFSET_MINUTOS=60
# Expresión cron de "pasada general" (cada 5 min) que el scheduler usa para evaluar
# qué sucursales ya cruzaron su hora objetivo (último turno + offset).
JOB_VENCIMIENTO_TICK_CRON=*/5 * * * *
