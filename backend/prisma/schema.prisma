// Walters Bakery — schema Prisma
// PostgreSQL
// Convenciones:
// - snake_case para nombres físicos, camelCase en modelos
// - IDs UUID v4
// - Timestamps con createdAt/updatedAt

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Catálogo: sucursales, productos, insumos, configuración
// ============================================================

enum TipoSucursal {
  central
  punto_venta
}

enum UnidadMedida {
  pieza
  kg
  lt
  paquete
}

enum TipoReuso {
  none
  materia_prima
  nuevo_producto
}

model Sucursal {
  id        String        @id @default(uuid())
  nombre    String
  codigo    String        @unique
  direccion String?
  tipo      TipoSucursal
  estado    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  usuarios              Usuario[]
  inventario            Inventario[]
  turnos                Turno[]
  ordenesProduccion     OrdenProduccion[]
  transferenciasOrigen  Transferencia[]   @relation("TransferenciaOrigen")
  transferenciasDestino Transferencia[]   @relation("TransferenciaDestino")
  cierres               Cierre[]
  mermas                Merma[]
  stockReutilizable     StockReutilizable[]
  notificaciones        Notificacion[]
}

// Turnos configurables por sucursal (CU-01.E).
// Validación de no-traslape se hace a nivel de aplicación al crear/editar.
model Turno {
  id              String   @id @default(uuid())
  sucursalId      String
  nombre          String
  horaInicio      String   // HH:mm
  horaFin         String   // HH:mm
  cruzaMedianoche Boolean  @default(false)
  orden           Int
  estado          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sucursal          Sucursal           @relation(fields: [sucursalId], references: [id])
  ordenesProduccion OrdenProduccion[]
  cierres           Cierre[]

  @@unique([sucursalId, orden])
  @@index([sucursalId, estado])
}

model ProductoTerminado {
  id              String     @id @default(uuid())
  sku             String     @unique
  nombre          String
  descripcion     String?
  unidad          UnidadMedida
  vidaUtilDias    Int        @default(1)
  precioVenta     Decimal    @db.Decimal(12, 2)
  reutilizable    Boolean    @default(false)
  tipoReuso       TipoReuso  @default(none)
  estado          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  recetas              Receta[]
  lotes                Lote[]
  inventario           Inventario[]
  detalleOrdenProduccion OrdenProduccionDetalleInsumoReal[]
  detalleTransferencia TransferenciaDetalle[]
  detalleCierre        CierreDetalle[]
  detalleReceta        RecetaDetalle[]
  umbralMerma          ConfiguracionMerma[]
  movimientos          MovimientoInventario[]
}

model Insumo {
  id                  String     @id @default(uuid())
  sku                 String     @unique
  nombre              String
  descripcion         String?
  unidad              UnidadMedida
  costoUnitarioActual Decimal    @db.Decimal(12, 4) @default(0)
  virtual             Boolean    @default(false)
  estado              Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  detalleReceta              RecetaDetalle[]
  detalleOrdenProduccion     OrdenProduccionDetalleInsumoReal[]
  detalleTransferencia       TransferenciaDetalle[]
  inventario                 Inventario[]
  movimientos                MovimientoInventario[]
  stockReutilizable          StockReutilizable[]
  configuracionMerma         ConfiguracionMerma[]
}

model ConfiguracionMerma {
  id                  String  @id @default(uuid())
  umbral              Int
  defaultGeneral      Boolean @default(false)
  productoTerminadoId String?
  insumoId            String?

  productoTerminado ProductoTerminado? @relation(fields: [productoTerminadoId], references: [id])
  insumo            Insumo?            @relation(fields: [insumoId], references: [id])

  @@index([productoTerminadoId])
  @@index([insumoId])
}

// ============================================================
// Recetas (BOM)
// ============================================================

model Receta {
  id                  String    @id @default(uuid())
  productoTerminadoId String
  version             Int       @default(1)
  vigenteDesde        DateTime  @default(now())
  vigenteHasta        DateTime?
  createdAt           DateTime  @default(now())

  productoTerminado ProductoTerminado  @relation(fields: [productoTerminadoId], references: [id])
  detalle           RecetaDetalle[]
  ordenesProduccion OrdenProduccion[]

  @@unique([productoTerminadoId, version])
}

model RecetaDetalle {
  id                 String  @id @default(uuid())
  recetaId           String
  insumoId          String
  productoTerminadoId String?
  cantidad           Decimal @db.Decimal(12, 4)
  unidad             UnidadMedida

  receta            Receta            @relation(fields: [recetaId], references: [id])
  insumo            Insumo            @relation(fields: [insumoId], references: [id])
  productoTerminado ProductoTerminado? @relation(fields: [productoTerminadoId], references: [id])

  @@unique([recetaId, insumoId])
}

// ============================================================
// Usuarios y roles
// ============================================================

enum Rol {
  administrador_general
  gerente_sucursal
  jefe_produccion
  encargado_cierre
  encargado_logistica
  auditor
}

model Usuario {
  id                   String    @id @default(uuid())
  nombre               String
  correo               String    @unique
  passwordHash         String
  rol                  Rol
  sucursalId           String?
  estado               Boolean   @default(true)
  debeCambiarPassword  Boolean   @default(true)
  ultimoCambioPassword DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  sucursal              Sucursal?             @relation(fields: [sucursalId], references: [id])
  ordenesProduccion     OrdenProduccion[]
  ordenesBitacora       OrdenProduccionBitacora[]
  cierres               Cierre[]
  mermasCreadas         Merma[]               @relation("MermaUsuarioCreador")
  mermasAprobadas       Merma[]               @relation("MermaUsuarioAprobador")
  movimientos           MovimientoInventario[]
  transferenciasCreadas Transferencia[]       @relation("TransferenciaUsuarioCreador")
  notificaciones        Notificacion[]
  auditoriaCambios      AuditoriaCambio[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  usuarioId String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

// ============================================================
// Producción: órdenes, lotes
// ============================================================

enum EstadoOrdenProduccion {
  planeada
  en_proceso
  confirmada
  cancelada
}

model OrdenProduccion {
  id                   String                @id @default(uuid())
  sucursalId           String
  recetaId             String
  fecha                DateTime
  turnoId              String
  cantidadPlaneada     Decimal               @db.Decimal(12, 4)
  cantidadRealProducida Decimal?             @db.Decimal(12, 4)
  estado               EstadoOrdenProduccion
  motivoCancelacion    String?
  usuarioCreadorId     String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  sucursal       Sucursal                                 @relation(fields: [sucursalId], references: [id])
  receta         Receta                                   @relation(fields: [recetaId], references: [id])
  turno          Turno                                    @relation(fields: [turnoId], references: [id])
  usuarioCreador Usuario                                  @relation(fields: [usuarioCreadorId], references: [id])
  lotes          Lote[]
  insumosReales  OrdenProduccionDetalleInsumoReal[]
  bitacora       OrdenProduccionBitacora[]
  mermas         Merma[]

  @@index([sucursalId, fecha, turnoId])
}

model OrdenProduccionDetalleInsumoReal {
  id                  String  @id @default(uuid())
  ordenProduccionId   String
  insumoId            String
  productoTerminadoId String?
  cantidadReal        Decimal @db.Decimal(12, 4)
  costoPromedioUsado  Decimal @db.Decimal(12, 4)

  ordenProduccion   OrdenProduccion  @relation(fields: [ordenProduccionId], references: [id])
  insumo            Insumo           @relation(fields: [insumoId], references: [id])
  productoTerminado ProductoTerminado? @relation(fields: [productoTerminadoId], references: [id])
}

model OrdenProduccionBitacora {
  id                String   @id @default(uuid())
  ordenProduccionId String
  campo             String
  valorAnterior     String?
  valorNuevo        String?
  usuarioId         String
  createdAt         DateTime @default(now())

  ordenProduccion OrdenProduccion @relation(fields: [ordenProduccionId], references: [id])
  usuario         Usuario         @relation(fields: [usuarioId], references: [id])

  @@index([ordenProduccionId])
}

model Lote {
  id                   String   @id @default(uuid())
  productoTerminadoId  String
  ordenProduccionId    String
  fechaProduccion      DateTime
  fechaVencimiento     DateTime
  cantidadInicial      Decimal  @db.Decimal(12, 4)
  cantidadDisponible   Decimal  @db.Decimal(12, 4)
  costoReal            Decimal  @db.Decimal(12, 4)
  enCuarentena         Boolean  @default(false) // espeja Inventario.enCuarentena
  createdAt            DateTime @default(now())

  productoTerminado   ProductoTerminado            @relation(fields: [productoTerminadoId], references: [id])
  ordenProduccion     OrdenProduccion              @relation(fields: [ordenProduccionId], references: [id])
  movimientos         MovimientoInventario[]
  detalleTransferencia TransferenciaDetalle[]
  stockReutilizable   StockReutilizable[]
  detalleCierre       CierreDetalle[]

  @@index([productoTerminadoId, fechaVencimiento])
  @@index([enCuarentena, fechaVencimiento])
}

// ============================================================
// Inventario y movimientos
// ============================================================

enum TipoReferencia {
  producto_terminado
  insumo
}

enum TipoMovimiento {
  compra
  produccion_consumo
  produccion_entrada
  venta
  transferencia_salida
  transferencia_entrada
  merma
  ajuste
  reuso_alta
}

model Inventario {
  id                  String         @id @default(uuid())
  sucursalId          String
  tipo                TipoReferencia
  productoTerminadoId String?
  insumoId            String?
  loteId              String?        @unique
  cantidad            Decimal        @db.Decimal(12, 4)
  costoPromedio       Decimal        @db.Decimal(12, 4)
  retenido            Boolean        @default(false) // CU-08 contingencia sin central
  enCuarentena        Boolean        @default(false) // CU-13.B Fase 1: en espera de clasificación
  updatedAt           DateTime       @updatedAt

  sucursal          Sucursal           @relation(fields: [sucursalId], references: [id])
  productoTerminado ProductoTerminado? @relation(fields: [productoTerminadoId], references: [id])
  insumo            Insumo?            @relation(fields: [insumoId], references: [id])

  @@unique([sucursalId, tipo, productoTerminadoId, loteId])
  @@index([sucursalId, tipo])
  @@index([sucursalId, retenido])
  @@index([sucursalId, enCuarentena])
}

model MovimientoInventario {
  id                   String         @id @default(uuid())
  sucursalId           String
  tipo                 TipoReferencia
  productoTerminadoId  String?
  insumoId             String?
  loteId               String?
  tipoMovimiento       TipoMovimiento
  cantidad             Decimal        @db.Decimal(12, 4)
  costoUnitario        Decimal        @db.Decimal(12, 4)
  usuarioId            String
  referenciaTipo       String?
  referenciaId         String?
  createdAt            DateTime       @default(now())

  productoTerminado ProductoTerminado? @relation(fields: [productoTerminadoId], references: [id])
  insumo            Insumo?            @relation(fields: [insumoId], references: [id])
  lote              Lote?              @relation(fields: [loteId], references: [id])
  usuario           Usuario            @relation(fields: [usuarioId], references: [id])

  @@index([sucursalId, createdAt])
  @@index([referenciaTipo, referenciaId])
}

// ============================================================
// Transferencias y recepción en central
// ============================================================

enum TipoIniciativaTransferencia {
  solicitud
  envio_directo
  retorno_cierre
}

enum EstadoTransferencia {
  solicitada
  aprobada
  rechazada
  en_transito
  recibida_pendiente_clasificar // CU-13.B Fase 1: recibida en cuarentena, falta clasificar
  completada
}

enum DestinoProductoCentral {
  venta_directa
  merma
  reuso
}

model Transferencia {
  id                   String                       @id @default(uuid())
  origenId             String
  destinoId            String
  tipoIniciativa       TipoIniciativaTransferencia
  estado               EstadoTransferencia
  usuarioCreadorId     String
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  completadaEn         DateTime?

  origen         Sucursal              @relation("TransferenciaOrigen", fields: [origenId], references: [id])
  destino        Sucursal              @relation("TransferenciaDestino", fields: [destinoId], references: [id])
  usuarioCreador Usuario               @relation("TransferenciaUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  detalle        TransferenciaDetalle[]
  mermasEnTransito Merma[]             @relation("TransferenciaMermaEnTransito")
  cierreId       String?               @unique
  cierre         Cierre?               @relation(fields: [cierreId], references: [id])

  @@index([estado])
  @@index([destinoId, estado])
}

model TransferenciaDetalle {
  id                    String          @id @default(uuid())
  transferenciaId       String
  tipo                  TipoReferencia
  productoTerminadoId   String?
  insumoId              String?
  loteId                String?
  cantidadEnviada       Decimal         @db.Decimal(12, 4)
  cantidadRecibida      Decimal?        @db.Decimal(12, 4)
  destinoCentral        DestinoProductoCentral?
  insumoVirtualId       String?

  transferencia     Transferencia      @relation(fields: [transferenciaId], references: [id])
  productoTerminado ProductoTerminado? @relation(fields: [productoTerminadoId], references: [id])
  insumo            Insumo?            @relation(fields: [insumoId], references: [id])
  lote              Lote?              @relation(fields: [loteId], references: [id])

  @@index([transferenciaId])
}

// ============================================================
// Stock reutilizable (solo en central)
// ============================================================

model StockReutilizable {
  id              String   @id @default(uuid())
  sucursalId      String
  insumoId        String
  loteOrigenId    String?
  cantidad        Decimal  @db.Decimal(12, 4)
  updatedAt       DateTime @updatedAt

  sucursal   Sucursal  @relation(fields: [sucursalId], references: [id])
  insumo     Insumo    @relation(fields: [insumoId], references: [id])
  loteOrigen Lote?     @relation(fields: [loteOrigenId], references: [id])

  @@unique([sucursalId, insumoId, loteOrigenId])
}

// ============================================================
// Cierres
// ============================================================

enum EstadoCierre {
  cerrado
}

model Cierre {
  id                String      @id @default(uuid())
  sucursalId        String
  fecha             DateTime
  turnoId           String
  totalRecaudado    Decimal     @db.Decimal(12, 2)
  estado            EstadoCierre @default(cerrado)
  contingencia      Boolean     @default(false) // true si cerró sin central configurada
  usuarioCreadorId  String
  createdAt         DateTime    @default(now())

  sucursal       Sucursal        @relation(fields: [sucursalId], references: [id])
  turno          Turno           @relation(fields: [turnoId], references: [id])
  usuarioCreador Usuario         @relation(fields: [usuarioCreadorId], references: [id])
  detalle        CierreDetalle[]
  transferencia  Transferencia?

  @@unique([sucursalId, fecha, turnoId])
}

model CierreDetalle {
  id                     String  @id @default(uuid())
  cierreId               String
  productoTerminadoId    String
  loteId                 String?
  cantidadVendida        Decimal @db.Decimal(12, 4)
  existenciaFinalDeclarada Decimal @db.Decimal(12, 4)

  cierre            Cierre            @relation(fields: [cierreId], references: [id])
  productoTerminado ProductoTerminado @relation(fields: [productoTerminadoId], references: [id])
  lote              Lote?             @relation(fields: [loteId], references: [id])
}

// ============================================================
// Mermas
// ============================================================

enum OrigenMerma {
  manual
  descuadre
  en_transito
}

enum EstadoMerma {
  pendiente_aprobacion
  confirmada
  rechazada
}

model Merma {
  id                   String      @id @default(uuid())
  sucursalId           String
  tipo                 TipoReferencia
  productoTerminadoId  String?
  insumoId             String?
  loteId               String?
  cantidad             Decimal     @db.Decimal(12, 4)
  motivo               String
  submotivo            String?
  estado               EstadoMerma
  origen               OrigenMerma
  usuarioCreadorId     String
  usuarioAprobadorId   String?
  fechaAprobacion      DateTime?
  referenciaOrigenTipo String?
  referenciaOrigenId   String?
  ordenProduccionId    String?
  transferenciaId      String?
  insumoVirtualDestinoId String?
  createdAt            DateTime    @default(now())

  sucursal              Sucursal?         @relation(fields: [sucursalId], references: [id])
  usuarioCreador        Usuario           @relation("MermaUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioAprobador      Usuario?          @relation("MermaUsuarioAprobador", fields: [usuarioAprobadorId], references: [id])
  ordenProduccion       OrdenProduccion?  @relation(fields: [ordenProduccionId], references: [id])
  transferencia         Transferencia?    @relation("TransferenciaMermaEnTransito", fields: [transferenciaId], references: [id])

  @@index([sucursalId, estado])
  @@index([origen])
}

// ============================================================
// Notificaciones y auditoría
// ============================================================

model Notificacion {
  id              String   @id @default(uuid())
  usuarioId       String
  tipo            String
  referenciaTipo  String?
  referenciaId    String?
  mensaje         String
  leida           Boolean  @default(false)
  emailEnviado    Boolean  @default(false)
  createdAt       DateTime @default(now())

  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  sucursalId String?
  sucursal  Sucursal?  @relation(fields: [sucursalId], references: [id])

  @@index([usuarioId, leida])
}

model AuditoriaCambio {
  id            String   @id @default(uuid())
  usuarioId     String
  entidad       String
  entidadId     String
  campo         String
  valorAnterior String?
  valorNuevo    String?
  createdAt     DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([entidad, entidadId])
}
